# React Native / Expo Environment Variables
# Copy this file to .env and fill in your values

EXPO_PUBLIC_RAPIDAPI_KEY=your_rapidapi_key_here
EXPO_PUBLIC_RAPIDAPI_HOST=iq-bible.p.rapidapi.com

# API URL for backend
# Development: http://localhost:3000/api
# Production: https://monotheism.vercel.app/api
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Environment (development or production)
EXPO_PUBLIC_ENV=development

# Solana RPC endpoint — use Alchemy or Helius for reliability
EXPO_PUBLIC_SOLANA_RPC=https://solana-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# SKR token config (do not change)
EXPO_PUBLIC_SKR_MINT=SKRbvo6Gf7GondiT3BbTfuRDPqLWei4j2Qy2NPGZhW3
EXPO_PUBLIC_SKR_DECIMALS=6

# Wallet that receives premium subscription payments
EXPO_PUBLIC_RECIPIENT_WALLET=
